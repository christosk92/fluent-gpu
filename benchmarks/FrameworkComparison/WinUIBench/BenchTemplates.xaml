<ResourceDictionary
    x:Class="WinUIBench.BenchTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIBench">
  <DataTemplate x:Key="BenchRowTemplate" x:DataType="local:BenchRowItem">
    <Grid Height="44" Padding="8,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>
      <Rectangle Width="28" Height="28" Fill="#464646" />
      <!-- Compiled binding, not a literal: the per-row re-bind and text re-layout on container recycling IS the
           virtualization work being measured, and the FluentGPU row binds the same "Row 00042" label. -->
      <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="Field A" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="Field B" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="Field C" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
