<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the portable, TerraFX-free FluentGpu.Media M0 surface (the unified Media Playback API). References
       FluentGpu.Engine ONLY (stays TerraFX-free — this exercises the headless layer with no GPU/backend). xUnit v3 to
       match app/Wavee.Tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- A test assembly is never published AOT; don't emit doc XML for it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPublishable>false</IsPublishable>
    <!-- Non-concurrent (blocking) gen2 GC — a MEASUREMENT fix for the zero-allocation facts that assert
         GC.GetAllocatedBytesForCurrentThread() deltas == 0 (the shipping libraries keep background GC on via
         src/Directory.Build.props). With background GC on, the counter over-reports up to ~8 KB when a background
         gen2 GC suspends the runtime inside the measured window, so an allocation-free loop can read non-zero under
         load. Same override as FluentGpu.VerticalSlice.csproj. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Pre-existing warning backlog (xUnit1051 cancellation-token nags across the media suites); the solution
         baseline enforces warnings-as-errors — clear the backlog before removing this opt-out. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentGpu.Engine\FluentGpu.Engine.csproj" />
  </ItemGroup>

</Project>
