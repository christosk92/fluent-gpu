<Project Sdk="Microsoft.NET.Sdk">

  <!-- M1 unit tests for the Windows Media-Foundation video backend (MfMediaPlayer/MfMediaSession) + the real
       MediaPlayerElement. Drives the HEADLESSLY-TESTABLE logic with a fake IVideoEngine + a fake IVideoPresenter — no
       real D3D11/MF/DComp device is created. xUnit v3 to match app/Wavee.Tests + FluentGpu.Engine.Tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPublishable>false</IsPublishable>
    <!-- Non-concurrent (blocking) gen2 GC — a MEASUREMENT fix for the zero-allocation facts that assert
         GC.GetAllocatedBytesForCurrentThread() deltas == 0 (the shipping libraries keep background GC on via
         src/Directory.Build.props). With background GC on, the counter over-reports up to ~8 KB when a background
         gen2 GC suspends the runtime inside the measured window, so an allocation-free loop can read non-zero under
         load. Same override as FluentGpu.VerticalSlice.csproj. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The backend under test is Windows-only interop; the tests inject fakes so no platform call runs, but the
         reference to the Windows backend surfaces CA1416 — suppress it in the test project only. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Pre-existing warning backlog (xUnit1051 in DrmTests and friends); the solution baseline enforces
         warnings-as-errors — clear the backlog before removing this opt-out. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentGpu.Engine\FluentGpu.Engine.csproj" />
    <ProjectReference Include="..\FluentGpu.Controls\FluentGpu.Controls.csproj" />
    <ProjectReference Include="..\FluentGpu.Windows\FluentGpu.Windows.csproj" />
    <!-- M5: the protected-video types (ProtectedVideoRuntime + its license relay / LicenseCachePolicy / ProtectedMediaSession /
         ProtectedMediaBackend / DashDescriptorMapper) live in WindowsApi, whose internals are visible to this assembly; the
         routing, relay, cache and session tests reference them directly. -->
    <ProjectReference Include="..\FluentGpu.WindowsApi\FluentGpu.WindowsApi.csproj" />
  </ItemGroup>

  <!-- Video fixtures (Fixtures/video/README.md) land under $(OutDir)Fixtures\video\; tests resolve them from
       AppContext.BaseDirectory. -->
  <ItemGroup>
    <None Update="Fixtures\video\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CencDemuxTests call FgPrProbeFile in FluentGpu.PlayReady.Native.dll. Copied beside the test assembly ONLY when it has
       been built (ops/tools/playready-native/build.cmd <arch>, or any build of FluentGpu.WindowsApp); a box without it
       still builds and those tests skip. The architecture is the test HOST's (PlayReadyNative.props), shared with the
       gallery so the two can never disagree. -->
  <Import Project="..\..\ops\tools\playready-native\PlayReadyNative.props" />
  <ItemGroup Condition="Exists('$(_PlayReadyNativeDll)')">
    <None Include="$(_PlayReadyNativeDll)" Link="FluentGpu.PlayReady.Native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
