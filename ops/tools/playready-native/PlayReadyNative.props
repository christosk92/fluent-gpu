<Project>
  <!-- Where FluentGpu.PlayReady.Native.dll lives for THIS build, shared by every project that ships or loads it
       (FluentGpu.WindowsApp builds + copies it; FluentGpu.Windows.Tests copies it for the demuxer gate).

       The architecture is the one the managed process will RUN as, which is not what the shell says:
         1. an explicit RuntimeIdentifier (a publish) wins;
         2. otherwise the SDK's own RID - `dotnet build` gives the exe an apphost of the SDK's architecture and
            `dotnet test` / `dotnet run` start it under that same muxer.
       PROCESSOR_ARCHITECTURE is NOT used: an x64-emulated shell on an ARM64 box reports AMD64 while the native arm64
       dotnet builds and runs an arm64 process, which then cannot load an x64 DLL (the demuxer tests silently skipped). -->
  <PropertyGroup>
    <_PlayReadyNativeRid>$(RuntimeIdentifier)</_PlayReadyNativeRid>
    <_PlayReadyNativeRid Condition="'$(_PlayReadyNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_PlayReadyNativeRid>
    <_PlayReadyNativeArch Condition="$(_PlayReadyNativeRid.EndsWith('-arm64'))">arm64</_PlayReadyNativeArch>
    <_PlayReadyNativeArch Condition="$(_PlayReadyNativeRid.EndsWith('-x64'))">x64</_PlayReadyNativeArch>
    <_PlayReadyNativeArch Condition="'$(_PlayReadyNativeArch)' == ''">arm64</_PlayReadyNativeArch>
    <_PlayReadyNativeDir>$(MSBuildThisFileDirectory.TrimEnd('\'))</_PlayReadyNativeDir>
    <_PlayReadyNativeDll>$(_PlayReadyNativeDir)\out\$(_PlayReadyNativeArch)\FluentGpu.PlayReady.Native.dll</_PlayReadyNativeDll>
    <!-- Machine-wide cache of built DLLs, keyed by a hash of the helper's sources: a fresh checkout or worktree copies
         the DLL instead of spending ~32 s in MSVC before the C# build can start (measured 2026-10-06). -->
    <_PlayReadyNativeCacheRoot Condition="'$(_PlayReadyNativeCacheRoot)' == ''">$(LOCALAPPDATA)\FluentGpu\playready-native</_PlayReadyNativeCacheRoot>
  </PropertyGroup>

  <ItemGroup>
    <_PlayReadyNativeCacheInputs Include="$(_PlayReadyNativeDir)\*.cpp;$(_PlayReadyNativeDir)\*.h;$(_PlayReadyNativeDir)\build.cmd;$(_PlayReadyNativeDir)\tests\*.cpp;$(_PlayReadyNativeDir)\tests\*.h" />
  </ItemGroup>

  <!-- The cache key: SHA-256 over "name hash" lines of every source (names, not paths, so every worktree agrees). -->
  <Target Name="_PlayReadyNativeCacheKey" Condition="'$(DesignTimeBuild)' != 'true' and '$(LOCALAPPDATA)' != ''">
    <GetFileHash Files="@(_PlayReadyNativeCacheInputs)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_PlayReadyNativeHashed" />
    </GetFileHash>
    <PropertyGroup>
      <_PlayReadyNativeKeyFile>$(IntermediateOutputPath)playready-native.$(_PlayReadyNativeArch).key</_PlayReadyNativeKeyFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PlayReadyNativeKeyFile)" Lines="@(_PlayReadyNativeHashed->'%(Filename)%(Extension) %(FileHash)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(_PlayReadyNativeKeyFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_PlayReadyNativeCacheKey" />
    </GetFileHash>
    <PropertyGroup>
      <_PlayReadyNativeCached>$(_PlayReadyNativeCacheRoot)\$(_PlayReadyNativeArch)\$(_PlayReadyNativeCacheKey)\FluentGpu.PlayReady.Native.dll</_PlayReadyNativeCached>
      <_PlayReadyNativeBuildStart>$([System.DateTime]::Now.Ticks)</_PlayReadyNativeBuildStart>
    </PropertyGroup>
  </Target>

  <!-- A cached DLL for these exact sources: copy it in and touch it, so BuildDesktopPlayReadyNative's Inputs/Outputs
       check sees it up to date and MSVC never runs. -->
  <Target Name="RestorePlayReadyNativeFromCache" BeforeTargets="BuildDesktopPlayReadyNative" DependsOnTargets="_PlayReadyNativeCacheKey"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(LOCALAPPDATA)' != ''">
    <Copy SourceFiles="$(_PlayReadyNativeCached)" DestinationFiles="$(_PlayReadyNativeDll)" Retries="3" ContinueOnError="true"
          Condition="Exists('$(_PlayReadyNativeCached)')" />
    <Touch Files="$(_PlayReadyNativeDll)" ContinueOnError="true" Condition="Exists('$(_PlayReadyNativeCached)') and Exists('$(_PlayReadyNativeDll)')" />
  </Target>

  <!-- Store a DLL that THIS build produced (written after the build started, so a stale DLL left by a failed MSVC run is
       never cached under the new sources' key). Best effort: a cache write never fails the build. -->
  <Target Name="SavePlayReadyNativeToCache" AfterTargets="BuildDesktopPlayReadyNative" DependsOnTargets="_PlayReadyNativeCacheKey"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(LOCALAPPDATA)' != '' and Exists('$(_PlayReadyNativeDll)')">
    <Copy SourceFiles="$(_PlayReadyNativeDll)" DestinationFiles="$(_PlayReadyNativeCached)" ContinueOnError="true"
          Condition="!Exists('$(_PlayReadyNativeCached)') and $([System.IO.File]::GetLastWriteTime('$(_PlayReadyNativeDll)').Ticks) &gt; $(_PlayReadyNativeBuildStart)" />
  </Target>
</Project>
